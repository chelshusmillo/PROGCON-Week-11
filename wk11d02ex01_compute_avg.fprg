<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="wk11d02ex01_compute_average"/>
        <attribute name="authors" value="riri"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 06:35:48 PM"/>
        <attribute name="created" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0wOS0yODswNzo1NDowMSBBTTsyNzc5"/>
        <attribute name="edited" value="cmlyaTtMQVBUT1AtQlJSOEhPRTM7MjAyNi0wOS0zMDswNjozNTo0OCBQTTsxMDsyOTUy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numbers" type="Integer" array="True" size="10"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="average" type="Real" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <while expression="i &lt; 10">
                <input variable="numbers[i]"/>
                <assign variable="i" expression="i + 1"/>
            </while>
            <assign variable="average" expression="computeAverage(numbers)"/>
            <output expression="&quot;The average is: &quot; &amp;average" newline="True"/>
        </body>
    </function>
    <function name="computeAverage" type="Real" variable="average">
        <parameters>
            <parameter name="numbers" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="average" type="Real" array="False" size=""/>
            <declare name="total, count, num, i" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <assign variable="num" expression="numbers[i]"/>
                <if expression="num == 0">
                    <then/>
                    <else>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count+1"/>
                    </else>
                </if>
            </for>
            <assign variable="average" expression="total/count"/>
        </body>
    </function>
</flowgorithm>
